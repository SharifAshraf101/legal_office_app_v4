{
  "manifest_version": 3,
  "name": "גשר נט המשפט ונט בתי הדין – משרד עו\"ד אשרף שריף",
  "version": "1.4.4",
  "description": "שולח נתוני תיקים, דיונים, החלטות ומסמכים מנט המשפט אל מערכת ניהול המשרד (legal-office-v4).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://*.court.gov.il/*",
    "https://unicourt.justice.gov.il/*",
    "https://*.workers.dev/*",
    "https://*.amazonaws.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.court.gov.il/*",
        "https://unicourt.justice.gov.il/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.court.gov.il/*",
        "https://unicourt.justice.gov.il/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "גשר נט המשפט",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
